    "匯出全部便利貼…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export All Notes…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出全部便利貼…"
          }
        }
      }
    },
    "匯出會把所有便利貼（包括垃圾桶裡的）存成一個檔案。在另一台 Mac 或重新安裝後匯入，已有的便利貼不會重複，同一張保留較新的版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporting saves every note, including those in the trash, to a single file. Import it on another Mac or after reinstalling: notes already there aren’t duplicated, and the newer version of a note is kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出會把所有便利貼（包括垃圾桶裡的）存成一個檔案。在另一台 Mac 或重新安裝後匯入，已有的便利貼不會重複，同一張保留較新的版本。"
          }
        }
      }
    },
    "只用視窗範圍": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Windows Only"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只用視窗範圍"
          }
        }
      }
    },
