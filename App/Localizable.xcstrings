{
  "sourceLanguage": "en",
  "strings": {
    "%@ 已用於「%@」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already used for “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已用於「%@」。"
          }
        }
      }
    },
    "%@ 已被系統使用（系統設定 › 鍵盤 › 鍵盤快速鍵）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already used by macOS (System Settings › Keyboard › Keyboard Shortcuts)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被系統使用（系統設定 › 鍵盤 › 鍵盤快速鍵）。"
          }
        }
      }
    },
    "%@ 常是其他 App 自己的快捷鍵，請再加上 ⌥ 或 ⌃。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is often an app’s own shortcut. Add ⌥ or ⌃."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 常是其他 App 自己的快捷鍵，請再加上 ⌥ 或 ⌃。"
          }
        }
      }
    },
    "%@：按一下展開，按住設定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Click to expand, hold for options"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：按一下展開，按住設定"
          }
        }
      }
    },
    "%@：按一下收合，按住設定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Click to collapse, hold for options"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：按一下收合，按住設定"
          }
        }
      }
    },
    "Claude 對話": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Conversation"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 對話"
          }
        }
      }
    },
