    "匯入備份…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Backup…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入備份…"
          }
        }
      }
