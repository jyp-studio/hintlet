      }
    },
    "還沒決定：第一次在 Claude 上新增便利貼時會詢問。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not decided yet: you’ll be asked the first time you add a note on Claude."
          }
        },
        "zh-Hant": {
